{
  "manifestVersion": 1,
  "id": "autocopy",
  "publisher": "heartheyouth",
  "name": "Autocopy",
  "version": "0.2.0",
  "description": "Copies files like .env from the main checkout into every new Orca worktree. Choose the files in ~/.config/autocopy/files.",
  "icon": "icon.svg",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "commands": [
      {
        "id": "edit-files",
        "title": "Autocopy: Edit files to copy",
        "context": "global"
      }
    ],
    "events": [
      {
        "on": "worktree.created"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "notifications:show"
    },
    {
      "kind": "events:subscribe"
    }
  ]
}
